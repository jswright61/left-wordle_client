#!/usr/bin/env bash
set -euo pipefail

# Client and api are versioned in lockstep: releasing either repo under a
# real tag (vX.Y.Z) requires the same tag to already exist in the other
# repo, reachable from the branch being deployed. Suffixed tags
# (vX.Y.Z-branch-name) are throwaway staging test deploys, not releases.
tag="${1:?Usage: bin/check-sibling-release <vX.Y.Z> <branch>}"
branch="${2:?Usage: bin/check-sibling-release <vX.Y.Z> <branch>}"

if ! [[ "$tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  exit 0
fi

client_dir="$(cd "$(dirname "$0")/.." && pwd)"
api_dir="$client_dir/../api"

if ! git -C "$api_dir" rev-parse --verify "refs/tags/$tag" &>/dev/null; then
  echo "api has no tag '$tag'." >&2
  exit 1
fi

if ! git -C "$api_dir" merge-base --is-ancestor "$tag" "$branch"; then
  echo "api's tag '$tag' is not reachable from api's $branch." >&2
  exit 1
fi

# The client computes remaining-answer counts from its alphabetized copy of
# the answers, so both lists must hold the same words at the release tag:
# five-letter words, sorted, de-duplicated. Only runs at deploy.
answer_words() { grep -oE "$1" | tr -d '"' | sort -u || true; }
api_words="$(git -C "$api_dir" show "$tag:db/seeds/answers.txt" | answer_words '^[a-z]{5}$')"
client_words="$(git -C "$client_dir" show "$tag:src/answer_list_sorted.js" | answer_words '"[a-z]{5}"')"
if [[ -z "$api_words" || "$api_words" != "$client_words" ]]; then
  echo "answer lists differ at '$tag': api db/seeds/answers.txt vs client src/answer_list_sorted.js" >&2
  diff <(printf '%s\n' "$api_words") <(printf '%s\n' "$client_words") | head -20 >&2 || true
  echo "Regenerate the client copy from api/: bundle exec rake client:generate_word_list" >&2
  exit 1
fi
